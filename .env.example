# Copy to .env.local (Next.js) or export in the deployment environment.

# Hosted PostgreSQL. Leave empty to use the embedded PGlite demo database.
DATABASE_URL=
PGSSL=false
PGLITE_DATA_DIR=.data/pglite

# Signing secret for staff sessions. Required in production.
AUTH_SECRET=local-demo-only-secret-not-for-production

# Public base URL, used in redirects.
APP_BASE_URL=http://localhost:3000

# Staff session lifetime in seconds (8 hours).
SESSION_MAX_AGE=28800

# All timestamps are stored in UTC and displayed in this zone.
APP_TIME_ZONE=Europe/London
