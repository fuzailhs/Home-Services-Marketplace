{
  "name": "home-services-marketplace",
  "version": "1.0.0",
  "private": true,
  "description": "A managed request board for a local home services company: customers submit a request, an administrator assigns a provider, the provider updates the job, and the customer can follow the status.",
  "scripts": {
    "predev": "npm run db:setup",
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "db:setup": "tsx scripts/setup.ts",
    "db:seed": "tsx scripts/seed-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^16.4.7",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.11"
  }
}
